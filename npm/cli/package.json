{
  "name": "@apitest/cli",
  "version": "0.1.0-alpha",
  "description": "API tests, load tests and OpenAPI contract pinning. Native binary + TypeScript types for JS suites.",
  "license": "(EUPL-1.2 OR MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunsided/apitest.git",
    "directory": "npm/cli"
  },
  "bin": {
    "apitest": "bin/apitest.js"
  },
  "main": "index.js",
  "types": "types/index.d.ts",
  "files": [
    "bin/",
    "types/",
    "index.js",
    "index.d.ts",
    "platforms.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@apitest/cli-linux-x64-gnu": "0.1.0-alpha",
    "@apitest/cli-linux-x64-musl": "0.1.0-alpha",
    "@apitest/cli-linux-arm64-gnu": "0.1.0-alpha",
    "@apitest/cli-linux-arm64-musl": "0.1.0-alpha",
    "@apitest/cli-darwin-arm64": "0.1.0-alpha",
    "@apitest/cli-darwin-x64": "0.1.0-alpha",
    "@apitest/cli-win32-x64-msvc": "0.1.0-alpha"
  },
  "keywords": [
    "api",
    "testing",
    "load-testing",
    "openapi",
    "contract-testing",

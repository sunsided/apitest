# apitest project config (NOVA). Run from this directory: apitest run
# Schema: crates/apitest/schemas/apitest-config.novs
@schema apitest-config@0.2.0

base_url: http://127.0.0.1:8080
lockfile: apitest.lock.nova
max_parallel: 8
test_timeout: @duration("30s")
js_workers: 2

vars:
  API_USER: demo
  API_PASS: secret

suites:
  - suites/billing.rhai
  - suites/billing.js

reports:
  junit: ../target/apitest/junit.xml
  json: ../target/apitest/report.json

# Comparison specs for the drift check (default: live only).
#   apitest contract check --against qa,next      # no running service needed
#   apitest run --against live,qa
drift:
  targets:
    qa:
      billing: specs/billing-1.1.yaml
    next:
      billing: specs/billing-2.0.yaml
